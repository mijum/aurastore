{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "server-dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["server/**/*.ts", "generated/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
